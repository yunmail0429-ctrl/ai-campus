APP_ENV=local
DATABASE_URL=postgresql+psycopg://xflj:replace-me@127.0.0.1:55432/xflj
TENANT_SLUG=xflj
COOKIE_SECURE=false
ALLOWED_ORIGINS=["http://localhost:3100","http://127.0.0.1:3100"]
# Server-owned OpenAI-compatible provider profiles. Use the actual API base URL.
# Never put real credentials in this example file or in model database records.
MODEL_PROVIDERS={}
MODEL_API_KEYS={}
# File infrastructure credentials belong only in the secret store / ignored .env.
# STORAGE={"bucket":"xflj-private","endpoint_url":"http://127.0.0.1:59000","region":"us-east-1","access_key":"replace-me","secret_key":"replace-me"}
# Production endpoints require HTTPS; AWS S3 can omit endpoint_url.
MAX_UPLOAD_BYTES=20971520
# CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=53310
# REDIS_URL=redis://:url-encoded-password@127.0.0.1:56379/0
# MODEL_PROVIDERS={"primary":{"label":"学校模型服务","base_url":"https://your-provider.example/v1","secret_ref":"primary","tenant_slugs":["xflj"],"token_limit_parameter":"max_completion_tokens"}}
# Set MODEL_API_KEYS through the deployment secret store, e.g. a JSON map keyed by "primary".
# Local-only fallback when PostgreSQL is not available:
# DATABASE_URL=sqlite:///./local-data/xflj.db
